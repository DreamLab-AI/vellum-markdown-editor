{
  "name": "vellum-markdown-editor",
  "displayName": "Vellum Markdown Editor",
  "description": "A live WYSIWYG Markdown editor for VS Code with Pele-rendered diagrams and hardened webviews. A modified version of Obsidian-style Markdown Live Editor by Thinh Vu.",
  "version": "0.5.0",
  "publisher": "dreamlab-ai",
  "author": {
    "name": "DreamLab AI Consulting Ltd"
  },
  "contributors": [
    {
      "name": "Thinh Vu",
      "url": "https://github.com/thinh-vu"
    }
  ],
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/DreamLab-AI/vellum-markdown-editor"
  },
  "homepage": "https://dreamlab-ai.com/",
  "bugs": {
    "url": "https://github.com/DreamLab-AI/vellum-markdown-editor/issues"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "preview"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages",
    "Machine Learning",
    "Visualization",
    "Linters"
  ],
  "browser": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.markdown"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "markdownLive.editor",
        "displayName": "Vellum Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.md",
            "scheme": "vscode-remote"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownLiveSidebar",
          "title": "Markdown Live",
          "icon": "$(markdown)"
        }
      ]
    },
    "views": {
      "markdownLiveSidebar": [
        {
          "type": "webview",
          "id": "markdownLive.fileBrowser",
          "name": "Notes"
        },
        {
          "id": "markdownLive.backlinks",
          "name": "Backlinks"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "markdown-live.openLiveEditor",
          "group": "navigation",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "markdown-live.showGraph",
          "group": "3_open@9",
          "when": "resourceLangId == markdown || activeCustomEditorId == markdownLive.editor"
        }
      ],
      "explorer/context": [
        {
          "command": "markdown-live.openLiveEditor",
          "group": "navigation",
          "when": "resourceLangId == markdown"
        }
      ],
      "view/title": [
        {
          "command": "markdown-live.newNote",
          "when": "view == markdownLive.fileBrowser",
          "group": "navigation@1"
        },
        {
          "command": "markdown-live.refreshSidebar",
          "when": "view == markdownLive.fileBrowser",
          "group": "navigation@2"
        },
        {
          "command": "markdown-live.refreshBacklinks",
          "when": "view == markdownLive.backlinks",
          "group": "navigation"
        },
        {
          "command": "markdown-live.copyLinkContext",
          "when": "view == markdownLive.backlinks",
          "group": "navigation"
        },
        {
          "command": "markdown-live.showGraph",
          "when": "view == markdownLive.backlinks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "markdown-live.linkMention",
          "when": "view == markdownLive.backlinks && viewItem == unlinked-mention",
          "group": "inline@1"
        },
        {
          "command": "markdown-live.openMentionInText",
          "when": "view == markdownLive.backlinks && viewItem =~ /mention$/",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "markdown-live.linkMention",
          "when": "false"
        },
        {
          "command": "markdown-live.openMentionInText",
          "when": "false"
        },
        {
          "command": "markdown-live.openNote",
          "when": "false"
        },
        {
          "command": "markdown-live.followWikilink",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "markdown-live.openLiveEditor",
        "title": "Open in Markdown Live Editor",
        "icon": "$(edit)"
      },
      {
        "command": "markdown-live.sendToAI",
        "title": "Send Selection to AI Assistant",
        "category": "Markdown Live"
      },
      {
        "command": "markdown-live.newNote",
        "title": "New Note",
        "icon": "$(add)"
      },
      {
        "command": "markdown-live.newNoteFromTemplate",
        "title": "New Note from Template"
      },
      {
        "command": "markdown-live.refreshSidebar",
        "title": "Refresh Notes",
        "icon": "$(refresh)"
      },
      {
        "command": "markdown-live.insertLink",
        "title": "Markdown Live: Insert Link"
      },
      {
        "command": "markdown-live.save",
        "title": "Markdown Live: Save File"
      },
      {
        "command": "markdown-live.insertTable",
        "title": "Markdown Live: Insert Table"
      },
      {
        "command": "markdown-live.insertHeading1",
        "title": "Markdown Live: Heading 1"
      },
      {
        "command": "markdown-live.insertHeading2",
        "title": "Markdown Live: Heading 2"
      },
      {
        "command": "markdown-live.insertHeading3",
        "title": "Markdown Live: Heading 3"
      },
      {
        "command": "markdown-live.insertHeading4",
        "title": "Markdown Live: Heading 4"
      },
      {
        "command": "markdown-live.insertHeading5",
        "title": "Markdown Live: Heading 5"
      },
      {
        "command": "markdown-live.insertHeading6",
        "title": "Markdown Live: Heading 6"
      },
      {
        "command": "markdown-live.insertCodeBlock",
        "title": "Markdown Live: Code Block"
      },
      {
        "command": "markdown-live.insertBlockquote",
        "title": "Markdown Live: Blockquote"
      },
      {
        "command": "markdown-live.insertImage",
        "title": "Markdown Live: Insert Image"
      },
      {
        "command": "markdown-live.toggleBold",
        "title": "Markdown Live: Bold"
      },
      {
        "command": "markdown-live.toggleItalic",
        "title": "Markdown Live: Toggle Italic"
      },
      {
        "command": "markdown-live.insertTemplate",
        "title": "Markdown Live: Insert Template"
      },
      {
        "command": "markdown-live.refreshBacklinks",
        "title": "Refresh Backlinks",
        "category": "Markdown Live",
        "icon": "$(refresh)"
      },
      {
        "command": "markdown-live.linkMention",
        "title": "Link This Mention",
        "category": "Markdown Live",
        "icon": "$(link)"
      },
      {
        "command": "markdown-live.openMentionInText",
        "title": "Open at Line in Text Editor",
        "category": "Markdown Live",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdown-live.openNote",
        "title": "Open Note in Live Editor",
        "category": "Markdown Live"
      },
      {
        "command": "markdown-live.followWikilink",
        "title": "Follow Wikilink",
        "category": "Markdown Live"
      },
      {
        "command": "markdown-live.revealSelection",
        "title": "Reveal Selection in Text Editor",
        "category": "Markdown Live",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdown-live.copyReference",
        "title": "Copy @-Reference to Selection",
        "category": "Markdown Live"
      },
      {
        "command": "markdown-live.copyLinkContext",
        "title": "Copy Note and Its Links as AI Context",
        "category": "Markdown Live",
        "icon": "$(references)"
      },
      {
        "command": "markdown-live.showGraph",
        "title": "Show Note Graph",
        "category": "Markdown Live",
        "icon": "$(type-hierarchy)"
      }
    ],
    "keybindings": [
      {
        "command": "markdown-live.openLiveEditor",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+ctrl+shift+m",
        "when": "resourceLangId == markdown"
      },
      {
        "command": "markdown-live.sendToAI",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertLink",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertTable",
        "key": "ctrl+shift+t",
        "mac": "cmd+opt+t",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading1",
        "key": "ctrl+shift+1",
        "mac": "cmd+opt+1",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading2",
        "key": "ctrl+shift+2",
        "mac": "cmd+opt+2",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading3",
        "key": "ctrl+shift+3",
        "mac": "cmd+opt+3",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading4",
        "key": "ctrl+shift+4",
        "mac": "cmd+opt+4",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading5",
        "key": "ctrl+shift+5",
        "mac": "cmd+opt+5",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertHeading6",
        "key": "ctrl+shift+6",
        "mac": "cmd+opt+6",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertCodeBlock",
        "key": "ctrl+shift+c",
        "mac": "cmd+opt+c",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertBlockquote",
        "key": "ctrl+shift+q",
        "mac": "cmd+opt+q",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertImage",
        "key": "ctrl+shift+i",
        "mac": "cmd+opt+i",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.toggleBold",
        "key": "ctrl+shift+b",
        "mac": "cmd+opt+b",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.toggleItalic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      },
      {
        "command": "markdown-live.insertTemplate",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "markdown-live.revealSelection",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+ctrl+shift+t",
        "when": "activeCustomEditorId == 'markdownLive.editor'"
      }
    ],
    "configuration": [
      {
        "type": "object",
        "title": "Markdown Live: General",
        "properties": {
          "markdownLive.language": {
            "type": "string",
            "enum": [
              "en",
              "vi"
            ],
            "default": "en",
            "description": "UI language for the Markdown Live Editor (en/vi)"
          },
          "markdownLive.tableDisplayMode": {
            "type": "string",
            "enum": [
              "scroll",
              "wrap"
            ],
            "default": "scroll",
            "description": "Table display mode: 'scroll' (horizontal scroll for wide tables) or 'wrap' (word wrap to fit screen)."
          },
          "markdownLive.updateLinksOnRename": {
            "type": "boolean",
            "default": true,
            "description": "When a note or folder is renamed or moved, update the wikilinks and Markdown links that point to it."
          },
          "markdownLive.aiTarget": {
            "type": "string",
            "enum": [
              "auto",
              "claude",
              "antigravity",
              "chat",
              "clipboard"
            ],
            "default": "auto",
            "enumDescriptions": [
              "Claude Code if installed, then Antigravity, then the built-in chat.",
              "Claude Code (anthropic.claude-code).",
              "Antigravity.",
              "The built-in VS Code chat.",
              "Copy the reference and text to the clipboard only."
            ],
            "description": "Where \"Send Selection to AI Assistant\" sends the selection."
          },
          "markdownLive.claudeDelivery": {
            "type": "string",
            "enum": [
              "selection",
              "newTab",
              "clipboard"
            ],
            "default": "selection",
            "enumDescriptions": [
              "Show the selection in a text editor beside the note, where Claude Code picks it up, and insert an @-mention if Claude offers that command.",
              "Open a new Claude Code tab with the reference pre-filled.",
              "Copy the @-reference to the clipboard only."
            ],
            "description": "How a selection reaches Claude Code. The @-reference is always copied to the clipboard as well."
          }
        }
      },
      {
        "type": "object",
        "title": "Markdown Live: Note Graph",
        "properties": {
          "markdownLive.graph.depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 1,
            "description": "How many links away from the note in focus the Note Graph shows when it opens. The graph's own control changes it for the open panel."
          }
        }
      },
      {
        "type": "object",
        "title": "Markdown Live: Editor & UI",
        "properties": {
          "markdownLive.fontFamily": {
            "type": "string",
            "enum": [
              "sans-serif",
              "serif"
            ],
            "default": "sans-serif",
            "description": "Font family used in the editor (default sans-serif or serif for a Substack-like feel)"
          },
          "markdownLive.enableSlashCommand": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable the '/' slash command menu in the editor."
          }
        }
      },
      {
        "type": "object",
        "title": "Markdown Live: Workspace & Notes",
        "properties": {
          "markdownLive.defaultNoteDirectory": {
            "type": "string",
            "default": "",
            "description": "Default directory to create new notes (relative to workspace root). Leave empty to create at the root."
          },
          "markdownLive.sidebarScanDirectory": {
            "type": "string",
            "default": "",
            "description": "Directory for the Sidebar to scan and display Markdown files (e.g., 'notes'). Leave empty to scan the entire workspace."
          },
          "markdownLive.templateFolder": {
            "type": "string",
            "default": "",
            "description": "Relative path from the workspace root to your templates folder (e.g., 'templates' or '.vscode/templates'). Leave empty to disable."
          }
        }
      },
      {
        "type": "object",
        "title": "Markdown Live: Images",
        "properties": {
          "markdownLive.imageDirectory": {
            "type": "string",
            "default": "assets/images",
            "description": "Directory to store images when pasted (e.g., assets/images)"
          },
          "markdownLive.imagePublicPath": {
            "type": "string",
            "default": "",
            "description": "Prefix applied to absolute image paths (starting with '/') in your Markdown. Example: if your image is `![Alt](/images/foo.png)` but the actual file is at `public/images/foo.png`, set this to `public`. Leave empty to resolve directly from the workspace root."
          }
        }
      },
      {
        "type": "object",
        "title": "Markdown Live: Printing & Export",
        "properties": {
          "markdownLive.printHeaderFormat": {
            "type": "string",
            "default": "{title}",
            "description": "Format for the printed header. Supports YAML variables like {title} or {author}."
          },
          "markdownLive.printFooterFormat": {
            "type": "string",
            "default": "{signature}",
            "description": "Format for the printed footer. Supports YAML variables like {signature} or {website}."
          },
          "markdownLive.printPageNumberFormat": {
            "type": "string",
            "default": "{page}",
            "description": "Format for page numbering when printing. Use {page} for current page. Leave empty to disable."
          },
          "markdownLive.printFontFamily": {
            "type": "string",
            "default": "",
            "description": "Custom font family to use when printing/exporting to PDF (e.g. 'Times New Roman, serif'). Leave empty to use the editor's default font."
          },
          "markdownLive.printAutoTOC": {
            "type": "boolean",
            "default": false,
            "description": "Automatically insert a Table of Contents at the beginning of the printed document."
          }
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "markdownLive.backlinks",
        "contents": "Open a Markdown note to see what links to it."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=browser",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=browser --watch",
    "package": "npm run copy-vendor && npm run compile-webview && npm run compile-graph && npm run compile",
    "compile-graph": "esbuild ./webview/graph/main.ts --bundle --outfile=dist/graph.js --platform=browser --format=iife --minify --loader:.wasm=binary --log-override:empty-import-meta=silent",
    "compile-webview": "esbuild ./webview/main.ts --bundle --outfile=dist/webview.js --platform=browser --minify --loader:.woff2=dataurl --loader:.woff=dataurl --loader:.ttf=dataurl",
    "watch-webview": "esbuild ./webview/main.ts --bundle --outfile=dist/webview.js --platform=browser --watch --loader:.woff2=dataurl --loader:.woff=dataurl --loader:.ttf=dataurl",
    "lint": "eslint \"{src,webview}/**/*.ts\"",
    "format": "prettier --write \"{src,webview}/**/*.ts\"",
    "test": "tsc -p tsconfig.test.json && vscode-test-web --browserType=chromium --extensionDevelopmentPath=.",
    "graph": "esbuild src/cli/vellum-graph.ts --bundle --platform=node --format=esm --outfile=out/vellum-graph.mjs --log-level=warning && node out/vellum-graph.mjs",
    "verify-pins": "node scripts/verify-pins.mjs",
    "copy-vendor": "node scripts/verify-pins.mjs --copy",
    "test:unit": "esbuild test/unit/*.test.ts --bundle --platform=node --format=esm --alias:vscode=./test/stubs/vscode.ts --outdir=.test-out --out-extension:.js=.mjs --log-level=warning && node --test .test-out/*.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/katex": "^0.16.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.19.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "mocha": "^11.8.0",
    "pagedjs": "0.4.3",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dreamlab-ai/ontomark-graph": "https://github.com/DreamLab-AI/ontomark/releases/download/ontomark-graph-v0.4.0/dreamlab-ai-ontomark-graph-0.4.0.tgz",
    "@dreamlab-ai/vowl-wasm": "https://github.com/DreamLab-AI/vowl-wasm/releases/download/v0.4.0/vowl-wasm-0.4.0-pkg.tgz",
    "@milkdown/core": "^7.3.5",
    "@milkdown/ctx": "^7.3.5",
    "@milkdown/plugin-clipboard": "^7.22.0",
    "@milkdown/plugin-history": "^7.3.5",
    "@milkdown/plugin-listener": "^7.22.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/plugin-prism": "^7.22.0",
    "@milkdown/plugin-slash": "^7.22.0",
    "@milkdown/preset-commonmark": "^7.3.5",
    "@milkdown/preset-gfm": "^7.3.5",
    "@milkdown/prose": "^7.22.0",
    "@milkdown/theme-nord": "^7.3.5",
    "@milkdown/utils": "^7.22.0",
    "codemirror": "^6.0.2",
    "katex": "^0.18.4",
    "pele": "1.12.0",
    "prism-themes": "^1.9.0",
    "remark-frontmatter": "^5.0.0",
    "remark-math": "^6.0.0"
  }
}
